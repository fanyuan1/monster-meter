    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "lints": "github:fanyuan1/lints",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.5"
